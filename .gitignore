*.xcodeproj/
App/Info.plist
CLI/Info.plist
App/*.entitlements
build*/
# Intermediates that a stray xcodebuild without a derived data path leaves at the root
*.o
*.d
*.dia
*.swiftdeps
*.swiftconstvalues
DerivedData/
xcuserdata/
*.xcresult

# Swift Package Manager
.build/
.swiftpm/

# Editor build and dependencies
editor/node_modules/
editor/dist/

# Local scratch
_tmp/
_local/
_ignore/
*.log
releases/
Config/Local.xcconfig
Config/Local.xcconfig.*
